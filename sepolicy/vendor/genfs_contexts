# Board-id
genfscon sysfs /firmware/devicetree/base/project-info/boardid    u:object_r:sysfs_board_id:s0

# glink
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,ucsi/power_supply/ucsi-source-psy-soc:qcom,pmic_glink:qcom,ucsi1/type    u:object_r:sysfs_power:s0
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,ucsi/power_supply/ucsi-source-psy-soc:qcom,pmic_glink:qcom,ucsi1/online  u:object_r:sysfs_power:s0
genfscon sysfs /devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,ucsi/power_supply/ucsi-source-psy-soc:qcom,pmic_glink:qcom,ucsi1/current_max u:object_r:sysfs_power:s0

# Logs
genfscon proc /last_kmsg u:object_r:vendor_log_device:s0

# Proximity
genfscon proc /touchscreen/proximity_switch            u:object_r:proc_proximity_ts:s0
genfscon proc /touchscreen/store_data_proximity        u:object_r:proc_proximity_ts:s0

# UFS
genfscon sysfs /devices/platform/soc/1d84000.ufshc/host0/target0:0:0/0:0:0:0/block/sda/queue/discard_max_bytes    u:object_r:ufs_block_device:s0
